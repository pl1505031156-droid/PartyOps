[Unit]
Description=PartyOps 主机签名更新与回滚服务
After=partyops.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/partyops/partyops.env
Environment=PARTYOPS_ENVIRONMENT=production
Environment=PARTYOPS_DATA_DIR=/var/lib/partyops
Environment=PARTYOPS_STRICT_SQLITE=true
ExecStart=/opt/partyops/partyops-updater --supervisor
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=false
PrivateTmp=true
# dpkg 需要原子替换 /opt、/usr、/lib 和 systemd 单元，不能使用只读系统
# 命名空间；安全边界由固定可执行路径、Ed25519 签名及清单白名单承担。
ProtectSystem=false

[Install]
WantedBy=multi-user.target
