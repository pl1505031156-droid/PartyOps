[Unit]
Description=PartyOps 基层党建工作闭环协同系统
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=partyops
Group=partyops
EnvironmentFile=-/etc/partyops/partyops.env
Environment=PARTYOPS_ENVIRONMENT=production
Environment=PARTYOPS_DATA_DIR=/var/lib/partyops
Environment=PARTYOPS_STRICT_SQLITE=true
Environment=PARTYOPS_SEED_DEMO=false
ExecStart=/opt/partyops/partyops
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
