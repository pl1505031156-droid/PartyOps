diff --git a/src/rust/src/declarative_asn1/types.rs b/src/rust/src/declarative_asn1/types.rs
index a8736df..9da403d 100644
--- a/src/rust/src/declarative_asn1/types.rs
+++ b/src/rust/src/declarative_asn1/types.rs
@@ -518,7 +518,7 @@ impl Null {
 }
 
 #[derive(pyo3::FromPyObject)]
-#[pyo3::pyclass(frozen, generic, module = "cryptography.hazmat.bindings._rust.asn1")]
+#[pyo3::pyclass(frozen, module = "cryptography.hazmat.bindings._rust.asn1")]
 pub struct SetOf {
     pub(crate) inner: pyo3::Py<pyo3::types::PyList>,
 }
@@ -531,6 +531,25 @@ impl SetOf {
         SetOf { inner }
     }
 
+    // PyO3 的 `generic` pyclass 直接调用 Py_GenericAlias；该符号只在
+    // Python 3.9+ 存在，会让面向 Win7 的 CPython 3.8 abi3 构建失败。
+    // Python 3.8 已提供 typing._GenericAlias，且 typing.get_origin/get_args
+    // 与 3.9+ 的使用契约一致。这里显式实现订阅协议，保持 SetOf[T] 的
+    // 声明式 ASN.1 语义，同时不引入任何 Python 3.9 ABI。
+    #[classmethod]
+    fn __class_getitem__<'py>(
+        cls: &pyo3::Bound<'py, pyo3::types::PyType>,
+        item: &pyo3::Bound<'py, pyo3::PyAny>,
+    ) -> pyo3::PyResult<pyo3::Py<pyo3::PyAny>> {
+        let py = cls.py();
+        let arguments = pyo3::types::PyTuple::new(py, [item])?;
+        Ok(py
+            .import("typing")?
+            .getattr("_GenericAlias")?
+            .call1((cls, arguments))?
+            .unbind())
+    }
+
     pub fn as_list(&self, py: pyo3::Python<'_>) -> pyo3::Py<pyo3::types::PyList> {
         self.inner.clone_ref(py)
     }
